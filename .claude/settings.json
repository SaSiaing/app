{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(flutter analyze:*)", "Bash(flutter test:*)", "Bash(flutter pub:*)",
      "Bash(dart format:*)", "Bash(dart run build_runner:*)", "Bash(dart analyze:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git branch:*)",
      "Bash(gh pr view:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)"
    ]
  }
}
